{
  "name": "gouttiere_grondin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:astro": "astro dev --root astro",
    "build": "next build",
    "build:astro": "astro build --root astro",
    "build:all": "npm run build && npm run build:astro",
    "start": "next dev",
    "start:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev",
    "start:prod": "npm run build:all && next start",
    "lint": "next lint",
    "postbuild": "next-sitemap"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@fortawesome/fontawesome-svg-core": "^6.4.0",
    "@fortawesome/free-brands-svg-icons": "^6.4.0",
    "@fortawesome/free-solid-svg-icons": "^6.4.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "next": "^15.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.1"
  },
  "devDependencies": {
    "@astrojs/react": "^4.3.0",
    "@astrojs/sitemap": "^3.3.0",
    "astro": "^5.6.1",
    "astro-compress": "^2.3.1",
    "eslint": "^9.24.0",
    "eslint-config-next": "^15.2.4",
    "next-sitemap": "^4.2.3"
  }
}
