---
import '../styles/global.css';
import '../../../src/App.css';
import '../../../src/CSS/Comment.css';
import '../../../src/CSS/ContactUs.css';
import '../../../src/CSS/FAQ.css';
import '../../../src/CSS/Gestion.css';
import '../../../src/CSS/Informations.css';
import '../../../src/CSS/Quand.css';
import '../../../src/CSS/Realisation.css';
import '../../../src/CSS/Services.css';
import CityPageReact from '../components/CityPageReact.jsx';
import QuickContact from '../components/QuickContact.jsx';
import { getLocalizedPath, useTranslations } from '../i18n/utils';
import { locales, routes, ui, type Lang, type RouteKey } from '../i18n/ui';

type City = {
  slug: string;
  frName: string;
  enName: string;
};

type CityContent = {
  meta_title: string;
  meta_description: string;
  h1: string;
  intro_paragraph: string;
  service_list_title: string;
  local_expertise: string;
  faq_q1: string;
  faq_a1: string;
  detailed_process_title?: string;
  detailed_process?: string;
};

type LocaleDictionary = {
  cities?: Record<string, CityContent>;
  common?: {
    phoneCta?: string;
    phoneAria?: string;
    switchToOtherLang?: string;
  };
  page?: {
    city?: {
      serviceBullets?: string[];
    };
  };
  nextPages?: {
    index?: Record<string, unknown>;
    services?: Record<string, unknown> & {
      maintenanceTexts?: string[];
    };
    contact?: Record<string, unknown>;
    faq?: Record<string, unknown> & {
      conclusion?: string[];
    };
    realisation?: Record<string, unknown>;
  };
};

type RouteDefinition = {
  lang: Lang;
  pathname: string;
  pageType: 'core' | 'city';
  routeKey?: RouteKey;
  city?: City;
};

type FaqEntry = {
  question?: string;
  answer?: string;
  q?: string;
  a?: string;
};

type ProjectEntry = {
  city?: string;
  title?: string;
  description?: string;
};

export function getStaticPaths() {
  const cities: City[] = [
    { slug: 'longueuil', frName: 'Longueuil', enName: 'Longueuil' },
    { slug: 'brossard', frName: 'Brossard', enName: 'Brossard' },
    { slug: 'boucherville', frName: 'Boucherville', enName: 'Boucherville' },
    { slug: 'saint-bruno', frName: 'Saint-Bruno-de-Montarville', enName: 'Saint-Bruno-de-Montarville' },
    { slug: 'candiac', frName: 'Candiac', enName: 'Candiac' },
    { slug: 'saint-lambert', frName: 'Saint-Lambert', enName: 'Saint-Lambert' },
    { slug: 'la-prairie', frName: 'La Prairie', enName: 'La Prairie' },
    { slug: 'chambly', frName: 'Chambly', enName: 'Chambly' },
    { slug: 'sainte-julie', frName: 'Sainte-Julie', enName: 'Sainte-Julie' },
    { slug: 'beloeil', frName: 'Beloeil', enName: 'Beloeil' },
  ];

  const normalizeLocalizedSlug = (path: string) => {
    return path
      .replace(/^\/+|\/+$/g, '')
      .replace(/^en(?:\/|$)/, '')
      .replace(/^\/+|\/+$/g, '');
  };

  const coreRouteDefinitions: RouteDefinition[] = (Object.keys(routes) as RouteKey[]).flatMap((routeKey) => {
    return locales.map((lang) => {
      const localizedCorePath = getLocalizedPath(lang, routes[routeKey][lang]);

      return {
        lang,
        pathname: normalizeLocalizedSlug(localizedCorePath),
        pageType: 'core' as const,
        routeKey,
      };
    });
  });

  const cityRouteDefinitions: RouteDefinition[] = cities.flatMap((city) => {
    return locales.map((lang) => {
      const localizedCityPath = getLocalizedPath(lang, city.slug);

      return {
        lang,
        pathname: normalizeLocalizedSlug(localizedCityPath),
        pageType: 'city' as const,
        city,
      };
    });
  });

  const routeDefinitions: RouteDefinition[] = [
    ...coreRouteDefinitions,
    ...cityRouteDefinitions,
  ];

  return routeDefinitions.map((route) => {
    const localizedPath = getLocalizedPath(route.lang, route.pathname);
    const slug = localizedPath === '/' ? undefined : localizedPath.slice(1);

    return {
      params: { slug },
      props: route,
    };
  });
}

const { lang, pathname, pageType, routeKey, city } = Astro.props as RouteDefinition;
const t = useTranslations(lang);
const localeDictionary = (ui[lang] ?? ui.fr) as LocaleDictionary;
const fallbackDictionary = ui.fr as LocaleDictionary;

const getString = (value: unknown, fallback = '') => {
  return typeof value === 'string' ? value : fallback;
};

const getArray = <T>(value: unknown): T[] => {
  return Array.isArray(value) ? (value as T[]) : [];
};

const nextPagesByRouteKey: Record<RouteKey, 'index' | 'services' | 'contact' | 'faq' | 'realisation'> = {
  home: 'index',
  services: 'services',
  contact: 'contact',
  faq: 'faq',
  portfolio: 'realisation',
};

const localeNextPages = (localeDictionary.nextPages ?? {}) as Record<string, unknown>;
const fallbackNextPages = (fallbackDictionary.nextPages ?? {}) as Record<string, unknown>;
const corePageData =
  pageType === 'core' && routeKey
    ? ((localeNextPages[nextPagesByRouteKey[routeKey]] ??
        fallbackNextPages[nextPagesByRouteKey[routeKey]] ??
        {}) as Record<string, unknown>)
    : ({} as Record<string, unknown>);

const isCityPage = pageType === 'city' && !!city;
const cityName = isCityPage
  ? (lang === 'fr' ? city.frName : city.enName)
  : '';
const cityData = isCityPage
  ? localeDictionary.cities?.[city.slug] ?? fallbackDictionary.cities?.[city.slug]
  : undefined;

const serviceBullets =
  localeDictionary.page?.city?.serviceBullets ??
  fallbackDictionary.page?.city?.serviceBullets ??
  (lang === 'fr'
    ? ['Nettoyage résidentiel', 'Inspection préventive', 'Installation de pare-feuilles']
    : ['Residential cleaning', 'Preventive inspection', 'Leaf-guard installation']);
const siteUrl = 'https://entretiensgouttieresrivesud.ca';
const normalizePathForHead = (value: string) => {
  return String(value ?? '')
    .split('?')[0]
    .split('#')[0]
    .replace(/^\/+|\/+$/g, '');
};
const normalizedPathname = normalizePathForHead(pathname);
const toAbsoluteUrl = (path: string) => new URL(path, `${siteUrl}/`).toString();
const localizedPath = getLocalizedPath(lang, normalizedPathname);
const canonical = toAbsoluteUrl(localizedPath);
const alternateFr = toAbsoluteUrl(getLocalizedPath('fr', normalizedPathname));
const alternateEn = toAbsoluteUrl(getLocalizedPath('en', normalizedPathname));

const cityTitle = cityData?.meta_title ?? t('seo.city.title', { city: cityName });
const cityDescription = cityData?.meta_description ?? t('seo.city.description', { city: cityName });
const coreTitle = getString(corePageData.headTitle, t('seo.home.title'));
const coreDescription = getString(corePageData.headDescription, t('seo.home.description'));
const title = isCityPage ? cityTitle : coreTitle;
const description = isCityPage ? cityDescription : coreDescription;

const htmlLang = lang === 'fr' ? 'fr-CA' : 'en-CA';
const ogLocale = lang === 'fr' ? 'fr_CA' : 'en_CA';
const alternateOgLocale = lang === 'fr' ? 'en_CA' : 'fr_CA';
const schemaDescription =
  lang === 'fr'
    ? "Nettoyage de gouttieres, debouchage, installation de protege-gouttieres et entretien preventif sur la Rive-Sud de Montreal."
    : 'Gutter cleaning, unclogging, gutter guard installation and preventive maintenance across Montreal South Shore.';
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${siteUrl}#local-business`,
  name: 'Les Entretiens Grondin',
  url: siteUrl,
  telephone: '1-819-237-9813',
  serviceType: 'Nettoyage de gouttieres',
  description: schemaDescription,
  availableLanguage: ['fr-CA', 'en-CA'],
  areaServed: [
    { '@type': 'City', name: 'Longueuil' },
    { '@type': 'City', name: 'Brossard' },
    { '@type': 'City', name: 'Boucherville' },
    { '@type': 'City', name: 'Saint-Bruno' },
    { '@type': 'City', name: 'Candiac' },
    { '@type': 'City', name: 'Saint-Lambert' },
    { '@type': 'City', name: 'La Prairie' },
    { '@type': 'City', name: 'Chambly' },
    { '@type': 'City', name: 'Sainte-Julie' },
    { '@type': 'City', name: 'Beloeil' },
  ],
};
const fallbackSectionTitle = t('page.city.sectionTitle', { city: cityName });
const fallbackSectionText =
  localeDictionary.nextPages?.services?.maintenanceTexts?.[0] ??
  fallbackDictionary.nextPages?.services?.maintenanceTexts?.[0] ??
  t('page.city.sectionText');
const fallbackFaqTitle = lang === 'fr' ? 'Question fréquente locale' : 'Local frequently asked question';
const faqSectionTitle = lang === 'fr' ? 'FAQ locale' : 'Local FAQ';
const fallbackFaqText =
  localeDictionary.nextPages?.faq?.conclusion?.[0] ??
  fallbackDictionary.nextPages?.faq?.conclusion?.[0] ??
  t('page.city.sectionText');
const localExpertiseHeading = lang === 'fr' ? 'Expertise locale' : 'Local expertise';
const localeCode = lang === 'en' ? 'en' : 'fr-CA';

const coreHeading = getString(
  corePageData.heading,
  getString(corePageData.topTitle, getString(corePageData.heroTitle, t('seo.home.title'))),
);
const coreLead = getString(
  corePageData.lead,
  getString(corePageData.topText, coreDescription),
);
const switchToOtherLang =
  localeDictionary.common?.switchToOtherLang ??
  fallbackDictionary.common?.switchToOtherLang ??
  (lang === 'fr' ? 'English version' : 'Version francaise');
const switchHref = lang === 'fr' ? getLocalizedPath('en', pathname) : getLocalizedPath('fr', pathname);
const phoneCta =
  localeDictionary.common?.phoneCta ??
  fallbackDictionary.common?.phoneCta ??
  (lang === 'fr' ? 'Appeler maintenant' : 'Call now');
const phoneAria =
  localeDictionary.common?.phoneAria ??
  fallbackDictionary.common?.phoneAria ??
  'Call Les Entretiens Grondin';

const servicesOffers = getArray<string>(corePageData.offersTexts);
const servicesMaintenance = getArray<string>(corePageData.maintenanceTexts);
const faqItems = getArray<FaqEntry>(corePageData.items);
const portfolioItems = getArray<ProjectEntry>(corePageData.items);
const homeServices = getArray<string>(corePageData.servicesItems);
const homeCitiesLeft = getArray<string>(corePageData.citiesLeft);
const homeCitiesRight = getArray<string>(corePageData.citiesRight);
---

<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={alternateOgLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://entretiensgouttieresrivesud.ca/logo.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://entretiensgouttieresrivesud.ca/logo.webp" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hrefLang="fr-CA" href={alternateFr} />
    <link rel="alternate" hrefLang="en-CA" href={alternateEn} />
    <link rel="alternate" hrefLang="x-default" href={alternateFr} />
    <link rel="icon" type="image/webp" href="/logo.webp" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  </head>
  <body>
    {
      isCityPage ? (
        <CityPageReact
          locale={localeCode}
          cityName={cityName}
          cityData={cityData}
          serviceBullets={serviceBullets}
          fallbackSectionTitle={fallbackSectionTitle}
          fallbackSectionText={fallbackSectionText}
          fallbackFaqTitle={fallbackFaqTitle}
          faqSectionTitle={faqSectionTitle}
          fallbackFaqText={fallbackFaqText}
          localExpertiseHeading={localExpertiseHeading}
          client:idle
        />
      ) : (
        <main class="page-wrap">
          <section class="hero-card">
            <p class="eyebrow">{getString(corePageData.heading, getString(corePageData.topTitle, 'Services'))}</p>
            <h1>{coreHeading}</h1>
            <p>{coreLead}</p>
            <div class="actions">
              <QuickContact label={phoneCta} ariaLabel={phoneAria} />
            </div>
            <p class="lang-switch"><a href={switchHref}>{switchToOtherLang}</a></p>
          </section>

          {routeKey === 'home' ? (
            <section class="content-card two-col">
              <article>
                <h2>{getString(corePageData.servicesTitle, 'Services')}</h2>
                <ul class="tick-list">
                  {homeServices.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
              <article>
                <h2>{getString(corePageData.citiesTitle, 'Villes desservies')}</h2>
                <ul class="tick-list">
                  {[...homeCitiesLeft, ...homeCitiesRight].map((cityItem) => (
                    <li>{cityItem}</li>
                  ))}
                </ul>
              </article>
            </section>
          ) : null}

          {routeKey === 'services' ? (
            <>
              <section class="content-card">
                <h2>{getString(corePageData.offersTitle, 'Offres de services')}</h2>
                <ul class="tick-list">
                  {servicesOffers.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </section>
              <section class="content-card two-col">
                <article>
                  <h3>{getString(corePageData.maintenanceTitle, 'Entretien')}</h3>
                  {servicesMaintenance.map((item) => (
                    <p>{item}</p>
                  ))}
                </article>
                <article>
                  <h3>{getString(corePageData.guardTitle, 'Pare-feuilles')}</h3>
                  <p>{getString(corePageData.guardText)}</p>
                </article>
              </section>
            </>
          ) : null}

          {routeKey === 'contact' ? (
            <>
              <section class="content-card two-col">
                <article>
                  <h2>{getString(corePageData.contactTitle, getString(corePageData.title, 'Coordonnees'))}</h2>
                  <p><strong>{getString(corePageData.phone, 'Telephone')}:</strong> 1-819-237-9813</p>
                  <p><strong>{getString(corePageData.email, 'Courriel')}:</strong> entretiensgrondin@hotmail.com</p>
                </article>
                <article>
                  <h2>{getString(corePageData.openHours, getString(corePageData.hoursTitle, 'Heures'))}</h2>
                  <p>{getString(corePageData.openWeek, getString(corePageData.weekHours))}</p>
                  <p>{getString(corePageData.openWeekend, getString(corePageData.weekendHours))}</p>
                </article>
              </section>
              <section class="content-card">
                <h2>{getString(corePageData.whyTitle, 'Pourquoi faire affaire avec un expert ?')}</h2>
                <p>{getString(corePageData.intro, getString(corePageData.whyText, coreLead))}</p>
              </section>
            </>
          ) : null}

          {routeKey === 'faq' ? (
            <section class="content-card">
              {faqItems.map((item) => (
                <article class="faq-item">
                  <h2>{getString(item.question, getString(item.q, 'Question'))}</h2>
                  <p>{getString(item.answer, getString(item.a, ''))}</p>
                </article>
              ))}
            </section>
          ) : null}

          {routeKey === 'portfolio' ? (
            <section class="content-card">
              {portfolioItems.map((item) => (
                <article class="faq-item">
                  <h2>{getString(item.title, getString(corePageData.heading, 'Projet'))}</h2>
                  {item.city ? <p><strong>{item.city}</strong></p> : null}
                  <p>{getString(item.description)}</p>
                </article>
              ))}
            </section>
          ) : null}
        </main>
      )
    }
  </body>
</html>
